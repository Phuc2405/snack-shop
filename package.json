{
  "name": "snack-shop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "firebase emulators:start --only auth,firestore --project demo-snack-shop",
    "seed:emu": "node scripts/seed-emulator.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-snack-shop \"node --test tests/rules/*.test.mjs\"",
    "check:size": "node scripts/check-bundle-size.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check": "npm run check:secrets && npm run typecheck && npm test && npm run build && npm run check:size",
    "deploy": "npm run check && firebase deploy --only hosting,firestore"
  },
  "dependencies": {
    "@fontsource/gelasio": "^5.3.0",
    "@hookform/resolvers": "^7.0.3",
    "clsx": "^2.1.1",
    "firebase": "^13.4.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "firebase-tools": "^15.37.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.2"
  }
}
