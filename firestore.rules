rules_version = '2';

// ============================================================================
//  Tiệm Ăn Vặt — Firestore Security Rules
//  Đây là "backend" thật của ứng dụng: mọi kiểm tra ở trình duyệt chỉ để tiện
//  cho người dùng, còn quyền và dữ liệu hợp lệ được quyết định ở đây.
//  Mọi đường dẫn KHÔNG khai báo bên dưới đều bị từ chối (deny by default),
//  nên không có "zombie API" — collection cũ/thử nghiệm không đọc ghi được.
//  Test: npm run test:rules   (tests/rules/*.test.mjs)
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() { return request.auth != null; }

    // Nhân viên = có tài khoản email/mật khẩu (không phải ẩn danh) VÀ có doc staff/{uid}.
    // Khách cũng có tài khoản email/mật khẩu nhưng KHÔNG có doc staff → không có quyền quản lý.
    // Doc staff chỉ tạo được trong Firebase Console → không ai tự nâng quyền được.
    function isStaff() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function shop() { return get(/databases/$(database)/documents/settings/shop).data; }

    function isStr(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function isInt(v, min, max) { return v is int && v >= min && v <= max; }
    function optStr(d, key, max) { return !(key in d) || isStr(d[key], 0, max); }

    // ---------- Sản phẩm: khách xem món đang hiện, chỉ nhân viên sửa ----------
    // Món ẩn (hidden == true): khách không đọc được (kể cả gọi thẳng API), nhân viên vẫn thấy.
    // Doc vẫn còn nên đơn cũ / báo cáo không mất gì.
    match /products/{productId} {
      allow get: if isStaff() || resource.data.get('hidden', false) == false;
      // Bắt buộc có limit để một truy vấn không đọc vô hạn (chống "denial of wallet");
      // khách phải lọc where('hidden', '==', false), không thì bị từ chối cả truy vấn.
      allow list: if request.query.limit <= 200 && (isStaff() || resource.data.hidden == false);
      allow create, update: if isStaff() && validProduct(request.resource.data);
      allow delete: if isStaff();
    }

    function validProduct(d) {
      return d.keys().hasOnly(['name', 'description', 'price', 'category', 'imageUrl',
                               'available', 'featured', 'sortOrder', 'hidden', 'options', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['name', 'price', 'category', 'available', 'featured', 'sortOrder', 'hidden', 'updatedAt'])
        && isStr(d.name, 1, 80)
        && optStr(d, 'description', 500)
        && isInt(d.price, 0, 10000000)
        && d.category in ['drink', 'cake', 'snack', 'combo']
        && (!('imageUrl' in d) || d.imageUrl == '' || (isStr(d.imageUrl, 9, 500) && d.imageUrl.matches('^https://[^\\s"<>]+$')))
        && d.available is bool
        && d.featured is bool
        && d.hidden is bool
        && isInt(d.sortOrder, 0, 9999)
        // Tuỳ chọn (size/đường/đá/topping): rules không lặp được vào từng nhóm → giới hạn số nhóm;
        // giá tuỳ chọn trong đơn được dashboard đối chiếu với menu (auditOrder)
        && (!('options' in d) || (d.options is list && d.options.size() <= 8))
        && d.updatedAt == request.time;
    }

    // ---------- Cấu hình tiệm: 1 doc duy nhất settings/shop ----------
    match /settings/{docId} {
      allow get: if docId == 'shop';
      allow list: if false;
      allow write: if isStaff() && docId == 'shop' && validSettings(request.resource.data);
    }

    function validSettings(d) {
      return d.keys().hasOnly(['name', 'tagline', 'hotline', 'address', 'openHours', 'isOpen',
                               'deliveryFee', 'freeShipFrom', 'minOrder', 'announcement',
                               'bankBin', 'bankAccount', 'bankAccountName', 'shipFeeMode', 'shipPrepaid', 'updatedAt'])
        && d.keys().hasAll(['name', 'hotline', 'isOpen', 'deliveryFee', 'minOrder', 'updatedAt'])
        && isStr(d.name, 1, 60)
        && optStr(d, 'tagline', 120)
        && isStr(d.hotline, 0, 20)
        && optStr(d, 'address', 200)
        && optStr(d, 'openHours', 80)
        && optStr(d, 'announcement', 200)
        && d.isOpen is bool
        && isInt(d.deliveryFee, 0, 500000)
        && isInt(d.minOrder, 0, 5000000)
        && (!('freeShipFrom' in d) || isInt(d.freeShipFrom, 0, 50000000))
        && (!('bankBin' in d) || d.bankBin == '' || d.bankBin.matches('^[0-9]{6}$'))
        && (!('bankAccount' in d) || d.bankAccount == '' || d.bankAccount.matches('^[0-9]{4,19}$'))
        && optStr(d, 'bankAccountName', 60)
        && (!('shipFeeMode' in d) || d.shipFeeMode in ['flat', 'driver'])
        && (!('shipPrepaid' in d) || d.shipPrepaid is bool)
        // Bắt chuyển khoản trước mà chưa có tài khoản → khách không đặt ship được → chặn cấu hình này
        && (d.get('shipPrepaid', false) == false || (d.get('bankAccount', '') != '' && d.get('bankBin', '') != ''))
        && d.updatedAt == request.time;
    }

    // ---------- Đơn hàng ----------
    match /orders/{orderId} {
      // Khách (kể cả ẩn danh) chỉ thấy đơn của chính mình; nhân viên thấy tất cả.
      allow get: if isStaff() || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow list: if (isStaff() && request.query.limit <= 500)
                  || (signedIn() && resource.data.customerUid == request.auth.uid && request.query.limit <= 50);

      // Tạo đơn: dữ liệu hợp lệ + tiệm đang mở + phải ghi kèm throttle/{uid} trong CÙNG batch
      // (throttle chỉ ghi được 1 lần/60 giây → mỗi khách tối đa 1 đơn/phút).
      allow create: if signedIn()
        && validNewOrder(request.resource.data)
        && getAfter(/databases/$(database)/documents/throttle/$(request.auth.uid)).data.lastOrderAt == request.time;

      allow update: if customerCancels() || staffUpdates();
      allow delete: if false; // giữ lịch sử, chỉ huỷ
    }

    function validNewOrder(d) {
      let s = shop();
      return d.keys().hasOnly(['code', 'customerUid', 'customer', 'fulfillment', 'items', 'itemCount',
                               'subtotal', 'deliveryFee', 'total', 'status', 'paymentMethod', 'paid',
                               'shipToDriver', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['code', 'customerUid', 'customer', 'fulfillment', 'items', 'itemCount',
                            'subtotal', 'deliveryFee', 'total', 'status', 'paymentMethod', 'paid',
                            'shipToDriver', 'createdAt', 'updatedAt'])
        && d.customerUid == request.auth.uid
        && d.status == 'new'
        // Khách không tự đánh dấu "đã trả tiền"; chuyển khoản chỉ khi tiệm đã khai báo tài khoản
        && d.paid == false
        && (d.paymentMethod == 'cod' || (d.paymentMethod == 'transfer' && s.get('bankAccount', '') != ''))
        // Tiệm bật "đơn ship phải chuyển khoản trước" → đơn ship không được chọn tiền mặt
        // (PHẢI giống allowedPayments() trong src/domain/pricing.ts)
        && !(d.fulfillment == 'delivery' && s.get('shipPrepaid', false) == true && d.paymentMethod != 'transfer')
        && d.shipToDriver == (d.fulfillment == 'delivery' && s.get('shipFeeMode', 'flat') == 'driver')
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && isStr(d.code, 4, 16)
        && validCustomer(d.customer, d.fulfillment)
        && d.items is list && d.items.size() >= 1 && d.items.size() <= 30
        && isInt(d.itemCount, 1, 300)
        && isInt(d.subtotal, 0, 50000000)
        && d.total == d.subtotal + d.deliveryFee
        && s.isOpen == true
        && d.subtotal >= s.minOrder
        && d.deliveryFee == expectedDeliveryFee(d, s);
    }

    // Phí ship — PHẢI giống deliveryFeeFor() trong src/domain/pricing.ts (có test so khớp)
    function expectedDeliveryFee(d, s) {
      return d.fulfillment == 'pickup' ? 0
        : s.get('shipFeeMode', 'flat') == 'driver' ? 0
        : (s.get('freeShipFrom', 0) > 0 && d.subtotal >= s.get('freeShipFrom', 0)) ? 0
        : s.deliveryFee;
    }

    function validCustomer(c, fulfillment) {
      return c is map
        && c.keys().hasOnly(['name', 'phone', 'address', 'note'])
        && c.keys().hasAll(['name', 'phone', 'address', 'note'])
        && isStr(c.name, 2, 60)
        && c.phone is string && c.phone.matches('^(0|\\+84)[0-9]{9,10}$')
        && isStr(c.note, 0, 300)
        && fulfillment in ['delivery', 'pickup']
        && (fulfillment == 'pickup' ? isStr(c.address, 0, 200) : isStr(c.address, 5, 200));
    }

    // Khách tự huỷ khi đơn còn "new" (tiệm chưa nhận).
    function customerCancels() {
      let before = resource.data;
      let after = request.resource.data;
      return signedIn()
        && before.customerUid == request.auth.uid
        && before.status == 'new'
        && after.status == 'cancelled'
        && after.cancelledBy == 'customer'
        && after.updatedAt == request.time
        && after.diff(before).affectedKeys().hasOnly(['status', 'updatedAt', 'cancelledBy', 'cancelReason', 'cancelNote'])
        // BẮT BUỘC lý do (PHẢI khớp CUSTOMER_CANCEL_REASONS trong src/domain/cancelReasons.ts)
        && after.get('cancelReason', '') in ['changed_mind', 'wrong_items', 'wrong_info', 'too_slow', 'other']
        && validCancelNote(after);
    }

    // Ghi chú huỷ: không bắt buộc (≤ 200 ký tự), riêng lý do "other" phải ghi ít nhất 3 ký tự
    function validCancelNote(a) {
      return (!('cancelNote' in a) || isStr(a.cancelNote, 0, 200))
        && (a.get('cancelReason', '') != 'other' || isStr(a.get('cancelNote', ''), 3, 200));
    }

    // Nhân viên chuyển trạng thái theo đúng máy trạng thái (giống src/domain/orderStatus.ts).
    function staffUpdates() {
      let before = resource.data;
      let after = request.resource.data;
      return isStaff()
        && after.diff(before).affectedKeys().hasOnly(['status', 'updatedAt', 'cancelledBy', 'staffNote', 'paid', 'cancelReason', 'cancelNote'])
        && after.updatedAt == request.time
        && after.get('paid', false) is bool // đơn cũ (trước khi có thanh toán) chưa có field paid
        && (after.status == before.status || after.status in nextStatuses()[before.status])
        && (!('staffNote' in after) || isStr(after.staffNote, 0, 300))
        && (!('cancelledBy' in after) || after.cancelledBy == 'shop' || after.cancelledBy == before.get('cancelledBy', null))
        // Tiệm huỷ: BẮT BUỘC lý do (PHẢI khớp SHOP_CANCEL_REASONS trong src/domain/cancelReasons.ts)
        && (after.status != 'cancelled' || before.status == 'cancelled'
            || (after.get('cancelReason', '') in ['sold_out', 'shop_busy', 'no_contact', 'out_of_area', 'customer_request', 'other']
                && validCancelNote(after)))
        // Lý do / ghi chú huỷ chỉ được ghi đúng lúc huỷ (không sửa lý do của khách / đơn cũ về sau)
        && (!after.diff(before).affectedKeys().hasAny(['cancelReason', 'cancelNote'])
            || (after.status == 'cancelled' && before.status != 'cancelled'));
    }

    function nextStatuses() {
      return {
        'new': ['confirmed', 'cancelled'],
        'confirmed': ['preparing', 'cancelled'],
        'preparing': ['delivering', 'cancelled'],
        'delivering': ['done', 'cancelled'],
        'done': [],
        'cancelled': []
      };
    }

    // ---------- Chống spam đơn: 1 doc / khách, không ai đọc được ----------
    match /throttle/{uid} {
      allow read: if false;
      allow create: if signedIn() && uid == request.auth.uid && validThrottle();
      allow update: if signedIn() && uid == request.auth.uid && validThrottle()
                    && resource.data.lastOrderAt < request.time - duration.value(60, 's');
      allow delete: if false;
    }

    function validThrottle() {
      return request.resource.data.keys().hasOnly(['lastOrderAt'])
        && request.resource.data.lastOrderAt == request.time;
    }

    // ---------- Tài khoản khách: sổ địa chỉ, chỉ chính chủ đọc/ghi ----------
    // Phải là tài khoản email/mật khẩu (token có email) — phiên ẩn danh không có sổ địa chỉ.
    // Nhân viên cũng KHÔNG đọc được: thông tin giao hàng cần thiết đã nằm trong từng đơn.
    match /users/{uid} {
      allow get, delete: if isAccountOwner(uid);
      allow list: if false;
      allow create, update: if isAccountOwner(uid) && validUserDoc(request.resource.data);
    }

    function isAccountOwner(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.get('email', '') != '';
    }

    function validUserDoc(d) {
      let a = d.addresses;
      return d.keys().hasOnly(['addresses', 'defaultAddressId', 'updatedAt'])
        && d.keys().hasAll(['addresses', 'defaultAddressId', 'updatedAt'])
        && a is list && a.size() <= 5
        && isStr(d.defaultAddressId, 0, 20)
        // Rules không có vòng lặp → kiểm từng phần tử theo chỉ số (tối đa 5)
        && (a.size() < 1 || validAddress(a[0]))
        && (a.size() < 2 || validAddress(a[1]))
        && (a.size() < 3 || validAddress(a[2]))
        && (a.size() < 4 || validAddress(a[3]))
        && (a.size() < 5 || validAddress(a[4]))
        && d.updatedAt == request.time;
    }

    // PHẢI khớp addressSchema trong src/schemas/checkout.schema.ts
    function validAddress(x) {
      return x is map
        && x.keys().hasOnly(['id', 'name', 'phone', 'address'])
        && x.keys().hasAll(['id', 'name', 'phone', 'address'])
        && isStr(x.id, 1, 20)
        && isStr(x.name, 2, 60)
        && x.phone is string && x.phone.matches('^(0|\\+84)[0-9]{9,10}$')
        && isStr(x.address, 0, 200);
    }

    // ---------- Danh sách nhân viên: chỉ sửa trong Firebase Console ----------
    match /staff/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
  }
}
