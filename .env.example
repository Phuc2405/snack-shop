# ---------------------------------------------------------------------------
# Cấu hình Firebase cho web (Firebase Console → Project settings → Your apps → Web app → Config).
# Các giá trị này KHÔNG phải mật khẩu (Google thiết kế để nằm trong trình duyệt),
# nhưng vẫn để trong .env (đã git-ignore) để không gắn cứng project vào code.
# Bảo vệ thật nằm ở firestore.rules + App Check. TUYỆT ĐỐI không đặt service account
# key hay bất kỳ khoá admin nào vào biến VITE_* (mọi biến VITE_* đều lộ ra trình duyệt).
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Tuỳ chọn — App Check (reCAPTCHA v3) chặn bot gọi thẳng vào Firestore. Để trống = tắt.
VITE_APPCHECK_SITE_KEY=

# Chạy với Firebase Emulator trên máy (không cần project thật): true / false
VITE_USE_EMULATORS=false
